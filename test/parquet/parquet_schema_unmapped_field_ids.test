# name: test/parquet/parquet_schema_unmapped_field_ids.test
# description: Columns without a field id must not hide the columns after them from the schema parameter
# group: [parquet]

require parquet

statement ok
COPY (SELECT 1 id, 2 a, 3 dropped, 4 b) TO '{TEMP_DIR}/unmapped_middle.parquet' (FIELD_IDS {id: 1, a: 2, b: 3});

query III
SELECT * FROM read_parquet('{TEMP_DIR}/unmapped_middle.parquet', schema=map {
	1: {name: 'id', type: 'INTEGER', default_value: NULL},
	2: {name: 'a', type: 'INTEGER', default_value: NULL},
	3: {name: 'b', type: 'INTEGER', default_value: NULL}
})
----
1	2	4

statement ok
COPY (SELECT 3 dropped, 1 id, 2 a, 4 b) TO '{TEMP_DIR}/unmapped_first.parquet' (FIELD_IDS {id: 1, a: 2, b: 3});

query III
SELECT * FROM read_parquet('{TEMP_DIR}/unmapped_first.parquet', schema=map {
	1: {name: 'id', type: 'INTEGER', default_value: NULL},
	2: {name: 'a', type: 'INTEGER', default_value: NULL},
	3: {name: 'b', type: 'INTEGER', default_value: NULL}
})
----
1	2	4

statement ok
COPY (SELECT 1 id, {'x': 10, 'dropped': 11, 'y': 12} s) TO '{TEMP_DIR}/unmapped_nested.parquet' (FIELD_IDS {
	id: 1,
	s: {__duckdb_field_id: 2, x: 3, y: 4}
});

query II
SELECT * FROM read_parquet('{TEMP_DIR}/unmapped_nested.parquet', schema=map {
	1: {name: 'id', type: 'INTEGER', default_value: NULL},
	2: {
		name: 's', type: 'STRUCT(x INTEGER, y INTEGER)', default_value: NULL,
		children: map {
			3: {name: 'x', type: 'INTEGER', default_value: NULL},
			4: {name: 'y', type: 'INTEGER', default_value: NULL}
		}
	}
})
----
1	{'x': 10, 'y': 12}

# a field id missing from the file reads its default, and the column without a field id is not exposed
query III
SELECT * FROM read_parquet('{TEMP_DIR}/unmapped_middle.parquet', schema=map {
	3: {name: 'b', type: 'INTEGER', default_value: NULL},
	4: {name: 'c', type: 'INTEGER', default_value: 9},
	1: {name: 'id', type: 'INTEGER', default_value: NULL}
})
----
4	9	1

statement error
SELECT dropped FROM read_parquet('{TEMP_DIR}/unmapped_middle.parquet', schema=map {
	1: {name: 'id', type: 'INTEGER', default_value: NULL},
	3: {name: 'b', type: 'INTEGER', default_value: NULL}
})
----
Binder Error: Referenced column "dropped" not found
