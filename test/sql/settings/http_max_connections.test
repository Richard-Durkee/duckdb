# name: test/sql/settings/http_max_connections.test
# description: http_max_connections can only be set at startup
# group: [settings]

query I
SELECT current_setting('http_max_connections')
----
0

statement error
SET http_max_connections=128
----
<REGEX>:Invalid Input Error.*Cannot change http_max_connections while the database is running.*

statement error
SET GLOBAL http_max_connections=0
----
<REGEX>:Invalid Input Error.*Cannot change http_max_connections while the database is running.*
