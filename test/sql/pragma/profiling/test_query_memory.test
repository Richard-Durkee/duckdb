# name: test/sql/pragma/profiling/test_query_memory.test
# description: The memory a query holds is measured by its memory tracker
# group: [profiling]

require json

require no_vector_verification

statement ok
SET threads = 4;

statement ok
PRAGMA enable_profiling = 'json';

statement ok
PRAGMA profiling_output = '{TEST_DIR}/query_memory.json';

statement ok
SET tracked_metrics = ['query.peak_memory', 'query.memory_usage', 'query.unattributed_peak_memory',
                       'system.peak_buffer_memory'];

# the hash joins' row data is held in blocks, and their pointer tables come from the buffer allocator
statement ok
SELECT count(*) FROM range(2000000) a JOIN range(2000000) b ON a.range = b.range
JOIN range(2000000) c ON a.range = c.range;

statement ok
PRAGMA disable_profiling;

# on an otherwise idle database, what the query held trackers for what the buffer pool saw
query III
SELECT prof.query.peak_memory >= 0.9 * prof.system.peak_buffer_memory,
       prof.query.peak_memory <= 1.1 * prof.system.peak_buffer_memory,
       prof.query.memory_usage <= prof.query.peak_memory
FROM '{TEST_DIR}/query_memory.json' prof;
----
true	true	true
