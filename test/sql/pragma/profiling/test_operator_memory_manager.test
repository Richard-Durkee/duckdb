# name: test/sql/pragma/profiling/test_operator_memory_manager.test
# description: Non-spillable operator memory tracked via the generalized memory manager (FIXED reservation)
# group: [profiling]

require json

require no_vector_verification

statement ok
PRAGMA enable_profiling = 'json';

statement ok
PRAGMA profiling_output = '{TEST_DIR}/operator_memory_manager.json';

statement ok
SET tracked_metrics = ['operator.peak_memory', 'operator.type'];

# A not-equal join runs as a NESTED_LOOP_JOIN, which materializes the whole RHS in memory and registers
# a FIXED state with the memory manager, so its peak_memory is tracked and > 0.
statement ok
SELECT count(*) FROM (SELECT i FROM range(2000) t(i)) a
JOIN (SELECT i FROM range(2000) t(i)) b ON a.i <> b.i;

statement ok
PRAGMA disable_profiling;

# Plan shape: RESULT_COLLECTOR -> UNGROUPED_AGGREGATE -> NESTED_LOOP_JOIN.
query I
SELECT op2.peak_memory > 0
FROM '{TEST_DIR}/operator_memory_manager.json' prof,
     LATERAL unnest(prof.operator) t0(op0),
     LATERAL unnest(op0.children) t1(op1),
     LATERAL unnest(op1.children) t2(op2)
WHERE op2.type = 'NESTED_LOOP_JOIN';
----
true
