# name: test/sql/pragma/profiling/test_operator_peak_memory.test
# description: operator.peak_memory attributes a hash join's full footprint, including its pointer table
# group: [profiling]

require json

require no_vector_verification

statement ok
SET threads = 1;

statement ok
PRAGMA enable_profiling = 'json';

statement ok
PRAGMA profiling_output = '{TEST_DIR}/operator_peak_memory.json';

statement ok
SET tracked_metrics = ['operator.peak_memory', 'operator.type', 'query.peak_memory', 'query.unattributed_peak_memory'];

# The join's build side dominates memory: its row data is sunk into the hash table, and its pointer table is
# allocated through the buffer allocator during finalize. Both must be attributed to the join.
statement ok
SELECT count(*) FROM range(2000000) a JOIN range(2000000) b ON a.range = b.range;

statement ok
PRAGMA disable_profiling;

# Plan shape for COUNT(*) over a join: RESULT_COLLECTOR -> UNGROUPED_AGGREGATE -> HASH_JOIN.
query II
SELECT op2.peak_memory >= 0.9 * prof.query.peak_memory,
       prof.query.unattributed_peak_memory <= 0.1 * prof.query.peak_memory
FROM '{TEST_DIR}/operator_peak_memory.json' prof,
     LATERAL unnest(prof.operator) t0(op0),
     LATERAL unnest(op0.children) t1(op1),
     LATERAL unnest(op1.children) t2(op2)
WHERE op2.type = 'HASH_JOIN';
----
true	true
