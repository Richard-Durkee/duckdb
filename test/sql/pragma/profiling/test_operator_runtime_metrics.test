# name: test/sql/pragma/profiling/test_operator_runtime_metrics.test
# description: Generic per-operator runtime metric channel (AddOperatorMetric), demonstrated on hash join
# group: [profiling]

require json

require no_vector_verification

statement ok
PRAGMA enable_profiling = 'json';

statement ok
PRAGMA profiling_output = '{TEST_DIR}/operator_runtime_metrics.json';

statement ok
SET tracked_metrics = ['operator.extra_info', 'operator.type'];

# The hash join reports build-side stats at Finalize via the generic runtime-metric channel; they appear
# in the operator's extra_info alongside the plan-time params.
statement ok
SELECT count(*) FROM (SELECT i FROM range(500000) t(i)) a
JOIN (SELECT i FROM range(500000) t(i)) b ON a.i = b.i;

statement ok
PRAGMA disable_profiling;

# Plan shape: RESULT_COLLECTOR -> UNGROUPED_AGGREGATE -> HASH_JOIN.
query I
SELECT op2.extra_info.hash_build_count = '500000'
   AND op2.extra_info.hash_partition_count IS NOT NULL
FROM '{TEST_DIR}/operator_runtime_metrics.json' prof,
     LATERAL unnest(prof.operator) t0(op0),
     LATERAL unnest(op0.children) t1(op1),
     LATERAL unnest(op1.children) t2(op2)
WHERE op2.type = 'HASH_JOIN';
----
true
