# name: test/sql/table_function/duckdb_operator_memory.test
# description: duckdb_operator_memory() reports memory attributed to each operator instance of running profiled queries
# group: [table_function]

require no_vector_verification

statement ok
SET threads = 1;

# without profiling, no operator memory is attributed
statement ok con1
SELECT count(*) FROM range(1000000) a JOIN range(1000000) b ON a.range = b.range;

query I
SELECT count(*) FROM duckdb_operator_memory();
----
0

statement ok con1
PRAGMA enable_profiling = 'json';

statement ok con1
PRAGMA profiling_output = '{TEST_DIR}/duckdb_operator_memory.json';

statement ok con1
SELECT count(*) FROM range(1000000) a JOIN range(1000000) b ON a.range = b.range;

# only running queries are listed: the operators of a finished query are gone
# (test/api/test_operator_memory_attribution.cpp inspects a query while it runs)
query I
SELECT count(*) FROM duckdb_operator_memory();
----
0

statement ok con1
PRAGMA disable_profiling;
