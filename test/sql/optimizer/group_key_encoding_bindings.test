statement ok
CREATE TABLE ctas_target AS SELECT * FROM (SELECT a, sum(v) AS sv, count(*) AS n FROM fact JOIN dim ON fact.k = dim.k GROUP BY a) EXCEPT ALL SELECT * FROM (SELECT a, sum(v) AS sv, count(*) AS n FROM fact JOIN dim ON fact.k = dim.k WHERE dim.k > 7 GROUP BY a)

