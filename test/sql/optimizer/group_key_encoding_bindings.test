# a semi join on the encoded key of a window
query TI
SELECT * FROM (SELECT a, sv FROM (SELECT a, sum(v) AS sv, count(*) AS n FROM fact JOIN dim ON fact.k = dim.k GROUP BY a) WHERE a IN (SELECT a FROM (SELECT a, rank() OVER (ORDER BY sv DESC) AS r FROM (SELECT a, sum(v) AS sv, count(*) AS n FROM fact JOIN dim ON fact.k = dim.k GROUP BY a)) WHERE r <= 2)) ORDER BY ALL
