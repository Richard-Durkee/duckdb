# a recursive CTE with an encoded aggregate as the base
query TII
SELECT * FROM (WITH RECURSIVE r(a, sv, it) AS (SELECT a, sv, 0 FROM (SELECT a, sum(v) AS sv, count(*) AS n FROM fact JOIN dim ON fact.k = dim.k GROUP BY a) UNION ALL SELECT a, sv + 1, it + 1 FROM r WHERE it < 2) SELECT a, sv, it FROM r) ORDER BY ALL
