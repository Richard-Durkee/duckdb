# a CTE that is inlined twice, over a window
query TI
SELECT * FROM (WITH c AS NOT MATERIALIZED (SELECT a, sv, rank() OVER (ORDER BY sv) AS r FROM (SELECT a, sum(v) AS sv, count(*) AS n FROM fact JOIN dim ON fact.k = dim.k GROUP BY a)) SELECT x.a, y.r FROM c x JOIN c y ON x.r = y.r + 1) ORDER BY ALL
