# a CTE and a subquery over it
query TI
SELECT * FROM (WITH c AS (SELECT a, sum(v) AS sv, count(*) AS n FROM fact JOIN dim ON fact.k = dim.k GROUP BY a) SELECT a, sv FROM c WHERE sv >= (SELECT avg(sv) FROM c)) ORDER BY ALL
