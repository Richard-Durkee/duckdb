# NOT EXISTS with a window over an encoded aggregate
query I
SELECT k FROM dim WHERE NOT EXISTS (SELECT 1 FROM (SELECT a, rank() OVER (ORDER BY sv) AS r FROM (SELECT a, sum(v) AS sv, count(*) AS n FROM fact JOIN dim ON fact.k = dim.k GROUP BY a)) x WHERE x.a = dim.a AND x.r > 2) ORDER BY ALL
