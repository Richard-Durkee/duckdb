# a materialized CTE that is used twice
query TII
SELECT * FROM (WITH c AS MATERIALIZED (SELECT a, sum(v) AS sv, count(*) AS n FROM fact JOIN dim ON fact.k = dim.k GROUP BY a) SELECT x.a, x.sv, y.n FROM c x JOIN c y ON x.a IS NOT DISTINCT FROM y.a) ORDER BY ALL
