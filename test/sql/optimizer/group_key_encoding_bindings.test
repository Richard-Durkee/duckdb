# EXISTS with an encoded aggregate
query I
SELECT k FROM dim WHERE EXISTS (SELECT 1 FROM (SELECT a, sum(v) AS sv, count(*) AS n FROM fact JOIN dim ON fact.k = dim.k GROUP BY a) x WHERE x.a = dim.a AND x.sv > 14000) ORDER BY ALL
