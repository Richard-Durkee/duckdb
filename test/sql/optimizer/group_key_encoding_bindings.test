# nested subqueries: an aggregate over a window over an aggregate over a window
query TI
SELECT * FROM (SELECT a, sum(rk) AS total FROM (SELECT a, rank() OVER (ORDER BY n) AS rk FROM (SELECT a, count(*) AS n FROM (SELECT a, row_number() OVER (PARTITION BY a ORDER BY sv) AS rn, sv FROM (SELECT a, b, sum(v) AS sv FROM fact JOIN dim ON fact.k = dim.k GROUP BY a, b ) ) GROUP BY a)) GROUP BY a) ORDER BY ALL
