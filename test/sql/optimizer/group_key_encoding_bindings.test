# name: test/sql/optimizer/group_key_encoding_bindings.test
# description: Test that everything above an encoded aggregate reads the columns it needs, whatever the shape of the plan
# group: [optimizer]

# every query runs with the encoding forced, the expected rows are the rows of the plain plan

statement ok
CREATE TABLE dim AS SELECT i AS k,
	CASE WHEN i % 9 = 0 THEN NULL ELSE 'name_' || (i % 5)::VARCHAR END AS a,
	CASE WHEN i % 7 = 0 THEN NULL ELSE 'group_' || (i % 3)::VARCHAR END AS b
FROM range(30) t(i);

statement ok
CREATE TABLE fact AS SELECT i % 30 AS k, i AS v FROM range(600) t(i);

statement ok
SET debug_force_group_key_encoding = true;

# EXCEPT ALL over an encoded aggregate: the row number of the set operation sits on a window over the lookup
query TII
SELECT * FROM (SELECT * FROM (SELECT a, sum(v) AS sv, count(*) AS n FROM fact JOIN dim ON fact.k = dim.k GROUP BY a) EXCEPT ALL SELECT * FROM (SELECT a, sum(v) AS sv, count(*) AS n FROM fact JOIN dim ON fact.k = dim.k WHERE dim.k > 7 GROUP BY a)) ORDER BY ALL
----
name_0	30000	100
name_1	35820	120
name_2	29700	100
name_3	30000	100
name_4	30300	100
NULL	23880	80

