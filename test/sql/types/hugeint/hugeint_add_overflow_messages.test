# name: test/sql/types/hugeint/hugeint_add_overflow_messages.test
# description: Test HUGEINT addition overflow messages and carries between the 64-bit halves
# group: [hugeint]

statement error
SELECT sum(x) FROM (VALUES (170141183460469231731687303715884105727::HUGEINT), (1::HUGEINT)) t(x)
----
Overflow in HUGEINT addition: 170141183460469231731687303715884105727 + 1

statement error
SELECT sum(x) FROM (VALUES (-170141183460469231731687303715884105727::HUGEINT), (-2::HUGEINT)) t(x)
----
Overflow in HUGEINT addition: -170141183460469231731687303715884105727 + -2

query II
SELECT sum(x), sum(-x) FROM (VALUES (170141183460469231731687303715884105726::HUGEINT), (1::HUGEINT)) t(x)
----
170141183460469231731687303715884105727	-170141183460469231731687303715884105727

query I
SELECT sum(x) FROM (VALUES (-170141183460469231731687303715884105727::HUGEINT), (-1::HUGEINT)) t(x)
----
-170141183460469231731687303715884105728

# carries between the lower and upper 64 bits
query I
SELECT sum(x) FROM (VALUES (18446744073709551615::HUGEINT), (1::HUGEINT), (-18446744073709551616::HUGEINT), (-1::HUGEINT)) t(x)
----
-1
