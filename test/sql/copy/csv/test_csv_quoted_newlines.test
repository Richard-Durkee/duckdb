# name: test/sql/copy/csv/test_csv_quoted_newlines.test
# description: quoted_newlines = false ends a record at every new line, also inside quotes
# group: [csv]

statement ok
COPY (SELECT * FROM (VALUES ('1,"multi'), ('line",x'), ('2,"a,b",y'), ('3,"open'), ('4,z,w')) t(line))
TO '{TEST_DIR}/quoted_newlines.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

# by default the quoted new line is part of the value, which the parallel scanner refuses together with null_padding
statement error
SELECT * FROM read_csv('{TEST_DIR}/quoted_newlines.csv', columns = {'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'},
    auto_detect = false, header = false, quote = '"', strict_mode = false, null_padding = true);
----
The parallel scanner does not support null_padding in conjunction with quoted new lines

# every new line ends the record; a quote left open at the end of the line keeps what follows it
query III
SELECT * FROM read_csv('{TEST_DIR}/quoted_newlines.csv', columns = {'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'},
    auto_detect = false, header = false, quote = '"', strict_mode = false, null_padding = true, quoted_newlines = false);
----
1	multi	NULL
line"	x	NULL
2	a,b	y
3	open	NULL
4	z	w

# in strict mode a quote left open is an error
statement error
SELECT * FROM read_csv('{TEST_DIR}/quoted_newlines.csv', columns = {'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'},
    auto_detect = false, header = false, quote = '"', strict_mode = true, quoted_newlines = false);
----
Value with unterminated quote found

# carriage returns: \r\n and a lone \r end the record too
statement ok
COPY (SELECT '1,"a' || chr(13) || chr(10) || '2,"b",c' || chr(13) || chr(10) || '3,"d' || chr(13) || chr(10) AS line)
TO '{TEST_DIR}/quoted_newlines_crlf.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query III
SELECT a, b, c FROM read_csv('{TEST_DIR}/quoted_newlines_crlf.csv', columns = {'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'},
    auto_detect = false, header = false, quote = '"', strict_mode = false, null_padding = true, quoted_newlines = false,
    new_line = '\r\n');
----
1	a	NULL
2	b	c
3	d	NULL

# an escaped new line ends the record as well, and the escape with nothing after it is dropped
statement ok
COPY (SELECT * FROM (VALUES ('1,"a\'), ('b",c'), ('2,"d\"e",f')) t(line))
TO '{TEST_DIR}/quoted_newlines_escape.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

query III
SELECT * FROM read_csv('{TEST_DIR}/quoted_newlines_escape.csv', columns = {'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'},
    auto_detect = false, header = false, quote = '"', escape = '\', strict_mode = false, null_padding = true,
    quoted_newlines = false);
----
1	a	NULL
b"	c	NULL
2	d"e	f

# with null_padding, the parallel scanner reads such a file at any buffer and thread boundary
statement ok
COPY (SELECT CASE WHEN i % 7 = 0 THEN i || ',"x' WHEN i % 7 = 1 THEN 'y",' || i ELSE i || ',"v' || i || '",w' END
    FROM range(20000) t(i))
TO '{TEST_DIR}/quoted_newlines_parallel.csv' (FORMAT csv, HEADER false, QUOTE '', ESCAPE '');

loop buffer_size 64 70

query III
SELECT count(*), count(c), sum(length(b)) FROM read_csv('{TEST_DIR}/quoted_newlines_parallel.csv',
    columns = {'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, auto_detect = false, header = false, quote = '"',
    strict_mode = false, null_padding = true, quoted_newlines = false, buffer_size = {buffer_size});
----
20000	14285	93332

endloop

query III
SELECT count(*), count(c), sum(length(b)) FROM read_csv('{TEST_DIR}/quoted_newlines_parallel.csv',
    columns = {'a': 'VARCHAR', 'b': 'VARCHAR', 'c': 'VARCHAR'}, auto_detect = false, header = false, quote = '"',
    strict_mode = false, null_padding = true, quoted_newlines = false, parallel = false);
----
20000	14285	93332

# the sniffer honors the option
query I
SELECT count(*) FROM read_csv('{TEST_DIR}/quoted_newlines.csv', quoted_newlines = false, strict_mode = false,
    null_padding = true, header = false);
----
5

# COPY FROM
statement ok
CREATE TABLE t (a VARCHAR, b VARCHAR, c VARCHAR);

statement ok
COPY t FROM '{TEST_DIR}/quoted_newlines.csv' (AUTO_DETECT false, HEADER false, DELIMITER ',', QUOTE '"', STRICT_MODE false, NULL_PADDING true, QUOTED_NEWLINES false);

query I
SELECT count(*) FROM t;
----
5
